<UserControl x:Class="GitHubStore.App.Views.SourcesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Text[SourcesTitle]}" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="{Binding Text[WingetSearchPlaceholder]}"
                            Text="{Binding WingetQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find" QuerySubmitted="OnWingetSearchSubmitted" />
            <Button Grid.Column="1" Content="{Binding Text[WingetSearch]}" Click="OnWingetSearchClick" VerticalAlignment="Bottom" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <!-- 手动添加的 GitHub 仓库：按要求从目录页迁到这里 -->
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Text[ManualGitHubSource]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding Text[SourceDescription]}" TextWrapping="Wrap" />
                        <Button Content="{Binding Text[AddRepository]}" Click="OnAddRepositoryClick"
                                AutomationProperties.AutomationId="AddRepositoryButton" />
                        <TextBlock Text="{Binding Text[SourceIdentityDescription]}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Text[SourceCacheDescription]}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- winget 常用软件 -->
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Text[WingetSection]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding Text[WingetDescription]}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResultNotice}" TextWrapping="Wrap" FontSize="12" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Message="{Binding WingetStatus}" />
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Text[WingetNoResults]}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
                        <ListView ItemsSource="{Binding Packages}" SelectionMode="Single" MaxHeight="420">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Publisher}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{Binding Text[WingetInstallHint]}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding Text[CacheNotice]}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
