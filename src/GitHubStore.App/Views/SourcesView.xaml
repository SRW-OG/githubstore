<UserControl x:Class="GitHubStore.App.Views.SourcesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Text[SourcesTitle]}" Style="{StaticResource TitleTextBlockStyle}" />

        <Border Grid.Row="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Text[ManualGitHubSource]}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Text[SourceDescription]}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Text[SourceCacheDescription]}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding Text[AddRepository]}" Click="OnAddRepositoryClick" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AddRepositoryButton" />
            </Grid>
        </Border>

        <!-- winget 独立管理区域：不使用 GitHubStore 托管安装和启动器登记。 -->
        <Border Grid.Row="2" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Text[WingetSection]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding Text[WingetDescription]}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <AutoSuggestBox PlaceholderText="{Binding Text[WingetSearchPlaceholder]}"
                                    Text="{Binding WingetQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    QueryIcon="Find" QuerySubmitted="OnWingetSearchSubmitted" />
                    <Button Grid.Column="1" Content="{Binding Text[WingetSearch]}" Click="OnWingetSearchClick" VerticalAlignment="Bottom" />
                </Grid>
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Text="{Binding WingetStatus}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ResultNotice}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>

                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                    <Grid>
                        <TextBlock Text="{Binding Text[WingetNoResults]}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
                        <ListView ItemsSource="{Binding Packages}" SelectionMode="Single" SelectionChanged="OnWingetSelectionChanged"
                                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Id}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Publisher}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Version}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Text[WingetDetailsTitle]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{Binding Text[WingetDetailsHint]}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding Text[WingetInstall]}" Click="OnWingetInstallClick" IsEnabled="{Binding CanInstall}"
                                            AutomationProperties.AutomationId="WingetInstallButton" />
                                    <Button Content="{Binding Text[WingetCancelInstall]}" Click="OnWingetCancelInstallClick" IsEnabled="{Binding CanCancelInstall}"
                                            Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" Visibility="{Binding HasSelectedPackage, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Text="{Binding SelectedPackage.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedPackage.Id}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsDetailsBusy, Converter={StaticResource BooleanToVisibility}}" />
                                    <TextBlock Text="{Binding Text[WingetDetailsLoading]}" TextWrapping="Wrap" Visibility="{Binding IsDetailsBusy, Converter={StaticResource BooleanToVisibility}}" />
                                    <StackPanel Spacing="8" Visibility="{Binding HasDetailsError, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="{Binding DetailsError}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                        <Button Content="{Binding Text[WingetDetailsRetry]}" Click="OnWingetDetailsRetry" />
                                    </StackPanel>
                                    <StackPanel Spacing="8" Visibility="{Binding HasPackageDetails, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="{Binding Text[WingetDetailVersion]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailVersion}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text[WingetDetailPublisher]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailPublisher}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text[WingetDetailDescription]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailDescription}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text[WingetDetailLicense]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailLicense}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text[WingetDetailHomepage]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailHomepage}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text[WingetDetailPublisherUrl]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailPublisherUrl}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text[WingetDetailLicenseUrl]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailLicenseUrl}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text[WingetDetailReleaseNotes]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailReleaseNotes}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text[WingetDetailReleaseNotesUrl]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailReleaseNotesUrl}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4" Spacing="6" Visibility="{Binding HasInstallStatus, Converter={StaticResource BooleanToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{Binding InstallStatus}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Expander Header="{Binding Text[WingetInstallLog]}" HorizontalAlignment="Stretch"
                              Visibility="{Binding HasInstallOutput, Converter={StaticResource BooleanToVisibility}}">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding InstallOutput}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Text[WingetInstallHint]}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
