<UserControl
    x:Class="GitHubStore.App.Views.CatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12" Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding Text[Refresh]}" Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center" AutomationProperties.AutomationId="RefreshCatalogButton" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="10" Height="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="{Binding Text[SearchPlaceholder]}"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find" QuerySubmitted="OnSearchSubmitted" VerticalAlignment="Stretch"
                            AutomationProperties.Name="{Binding Text[SearchName]}" />
            <Button Grid.Column="1" Content="{Binding SearchWithAiLabel}" Command="{Binding SearchWithAiCommand}"
                    ToolTipService.ToolTip="{Binding SearchWithAiHint}" VerticalAlignment="Stretch"
                    AutomationProperties.AutomationId="AiCatalogSearchButton" />
            <ComboBox x:Name="SortSelector" Grid.Column="2" SelectionChanged="OnSortChanged" MinWidth="144"
                      VerticalAlignment="Stretch" AutomationProperties.Name="{Binding Text[Sort]}" />
        </Grid>
        <StackPanel x:Name="SearchFeedbackPanel" Grid.Row="2" Spacing="6" Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding AssistantSearchStatus}" TextWrapping="Wrap" MaxLines="2" IsTextSelectionEnabled="True"
                           VerticalAlignment="Center" AutomationProperties.AutomationId="AiCatalogSearchStatus" />
                <Button Grid.Column="1" Content="{Binding CancelAssistantLabel}" Command="{Binding CancelAssistantSearchCommand}"
                        Visibility="{Binding IsAssistantSearchBusy, Converter={StaticResource BooleanToVisibility}}"
                        AutomationProperties.AutomationId="CancelAiCatalogSearchButton" />
            </Grid>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsAssistantSearchBusy, Converter={StaticResource BooleanToVisibility}}" />
            <TextBlock Text="{Binding AssistantSearchError}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AutomationId="AiCatalogSearchError" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
        <ListView x:Name="AppList" Grid.Row="3" ItemsSource="{Binding Cards}" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="OnCardClick" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="{Binding Text[Applications]}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" CornerRadius="10" MinHeight="200" Loaded="OnCardLoaded" SizeChanged="OnCardSizeChanged" DataContextChanged="OnCardDataContextChanged"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="20" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border x:Name="CardPreview" Grid.RowSpan="3" Height="140" CornerRadius="6" VerticalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Image Stretch="Uniform" ImageFailed="OnScreenshotFailed"
                                           Visibility="{Binding HasScreenshot, Converter={StaticResource BooleanToVisibility}}"
                                           AutomationProperties.Name="{Binding ScreenshotLabel}" />
                                    <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="190"
                                                Visibility="{Binding HasNoScreenshot, Converter={StaticResource BooleanToVisibility}}">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="30" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding ScreenshotFallback}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ProgressRing Width="24" Height="24" IsActive="{Binding IsScreenshotLoading}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                  Visibility="{Binding IsScreenshotLoading, Converter={StaticResource BooleanToVisibility}}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <HyperlinkButton Content="{Binding RepositoryText}" NavigateUri="{Binding RepositoryUri}"
                                                 Padding="0" HorizontalAlignment="Left" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Spacing="7">
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{Binding FeaturesLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding FeaturesText}" TextWrapping="Wrap" MaxLines="3" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="CardMetadata" Grid.Column="2" Grid.RowSpan="2" Spacing="6" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding StarsText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding UpdatedLabel}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding UpdatedText}" FontSize="12" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding VersionLabel}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding LatestVersion}" FontSize="12" TextWrapping="Wrap" MaxLines="2" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel x:Name="CardActions" Grid.Column="2" Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="{Binding MoreLabel}" Click="OnCardMoreClick" AutomationProperties.AutomationId="CatalogCardMoreButton" />
                                <Button Content="{Binding InstallLabel}" Click="OnCardInstallClick" Style="{StaticResource AccentButtonStyle}"
                                        AutomationProperties.AutomationId="CatalogCardInstallButton" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="4" Spacing="6">
            <StackPanel x:Name="InstallationPanel" DataContext="{Binding Installation}" Spacing="6" Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="InstallStatusText" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   AutomationProperties.AutomationId="InstallErrorText" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding Text[Cancel]}" Command="{Binding CancelCommand}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.AutomationId="CancelInstallButton" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"
                             Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibility}}" />
                <Expander x:Name="DiagnosisPanel" Header="{Binding DiagnosisLabel}" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding DiagnosisLabel}" Command="{Binding DiagnoseCommand}" IsEnabled="{Binding CanDiagnose}"
                                    AutomationProperties.AutomationId="DiagnoseInstallButton" />
                            <Button Content="{Binding CancelDiagnosisLabel}" Command="{Binding CancelDiagnosisCommand}"
                                    Visibility="{Binding IsDiagnosisBusy, Converter={StaticResource BooleanToVisibility}}"
                                    AutomationProperties.AutomationId="CancelInstallDiagnosisButton" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsDiagnosisBusy, Converter={StaticResource BooleanToVisibility}}" />
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding DiagnosisMarkdown}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="InstallDiagnosisText" />
                                <TextBlock Text="{Binding DiagnosisError}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AutomationId="InstallDiagnosisError" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <!-- 命名此面板，任务模板才能用 ElementName 找到队列命令（模板自身的 DataContext 是单个任务）。 -->
            <StackPanel x:Name="DownloadQueuePanel" DataContext="{Binding Downloads}" Spacing="4" Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxLines="2" IsTextSelectionEnabled="True" FontSize="12" AutomationProperties.AutomationId="DownloadStatus" />
                    <Button Grid.Column="1" Content="{Binding Text[Cancel]}" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibility}}" />
                <!-- 下载队列：串行执行，任务持久化，重启后仍在。暂停保留可续传的部分数据。 -->
                <TextBlock Text="{Binding Text[DownloadQueueTitle]}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                <TextBlock Text="{Binding QueueStatus}" TextWrapping="Wrap" FontSize="12"
                           IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DownloadQueueStatus" />
                <TextBlock Text="{Binding Text[DownloadQueueEmpty]}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasQueueJobs, Converter={StaticResource InverseBooleanToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Queue}" AutomationProperties.AutomationId="DownloadQueueList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding FileName}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding StateLabel}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding SizeText}" />
                                        <Run Text="{Binding Detail}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ErrorText}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                                <ProgressBar Grid.Column="1" Width="90" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                             VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Content="{Binding Text[DownloadQueuePause]}" Command="{Binding DataContext.PauseJobCommand, ElementName=DownloadQueuePanel}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanPause, Converter={StaticResource BooleanToVisibility}}" FontSize="11" Padding="6,2" />
                                    <Button Content="{Binding Text[DownloadQueueResume]}" Command="{Binding DataContext.ResumeJobCommand, ElementName=DownloadQueuePanel}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanResume, Converter={StaticResource BooleanToVisibility}}" FontSize="11" Padding="6,2" />
                                    <Button Content="{Binding Text[DownloadQueueCancel]}" Command="{Binding DataContext.CancelJobCommand, ElementName=DownloadQueuePanel}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibility}}" FontSize="11" Padding="6,2" />
                                    <Button Content="{Binding Text[DownloadQueueRetry]}" Command="{Binding DataContext.RetryJobCommand, ElementName=DownloadQueuePanel}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibility}}" FontSize="11" Padding="6,2" />
                                    <Button Content="{Binding Text[DownloadQueueRemove]}" Command="{Binding DataContext.RemoveJobCommand, ElementName=DownloadQueuePanel}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibility}}" FontSize="11" Padding="6,2"
                                            ToolTipService.ToolTip="{Binding Text[DownloadQueueRemoveHint]}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibility}}" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding Text[LoadMore]}" Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
