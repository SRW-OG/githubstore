<UserControl
    x:Class="GitHubStore.App.Views.DiscoveryHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="DiscoveryEntryTemplate">
            <Border Padding="14" Margin="0,0,0,10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="9">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RankText}" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RepositoryName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxLines="4" IsTextSelectionEnabled="True"
                               Visibility="{Binding ShowDescription, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{Binding Language}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasLanguage, Converter={StaticResource BooleanToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Spacing="2" Visibility="{Binding HasStarsGained, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{Binding StarsGainedLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding StarsGainedText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Spacing="2" Visibility="{Binding HasTotalStars, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{Binding TotalStarsLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalStarsText}" />
                        </StackPanel>
                        <StackPanel Spacing="2" Visibility="{Binding HasTrendScore, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{Binding TrendScoreLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TrendScoreText}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{Binding HasSourceReview, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{Binding SourceReviewLabel}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SourceReview}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{Binding SourceReviewAttribution}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ReviewPublishedText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasReviewPublishedAt, Converter={StaticResource BooleanToVisibility}}" />
                        <HyperlinkButton Content="{Binding ReviewLinkLabel}" NavigateUri="{Binding ReviewUri}" Padding="0" HorizontalAlignment="Left"
                                         Visibility="{Binding HasReviewLink, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding NoSourceReviewLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding ShowNoSourceReviewNotice, Converter={StaticResource BooleanToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton Content="{Binding OpenRepositoryLabel}" NavigateUri="{Binding RepositoryUri}" Padding="0" />
                        <HyperlinkButton Content="{Binding OpenSourceLabel}" NavigateUri="{Binding SourceUri}" Padding="0" />
                        <Button Content="{Binding ReviewButtonLabel}" Command="{Binding ReviewCommand}" Padding="10,4"
                                AutomationProperties.AutomationId="DiscoveryAiReviewButton" />
                        <Button Content="{Binding CancelReviewLabel}" Command="{Binding CancelReviewCommand}" Padding="8,4"
                                Visibility="{Binding IsReviewBusy, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsReviewBusy, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Text="{Binding ReviewError}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding HasReviewError, Converter={StaticResource BooleanToVisibility}}" />
                    <StackPanel Spacing="6" Visibility="{Binding HasAiReview, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{Binding AiReviewLabel}" FontSize="12" FontWeight="SemiBold" />
                        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ContentControl Loaded="OnReviewHostLoaded" Unloaded="OnReviewHostUnloaded" HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="DiscoveryAiReviewOutput" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DiscoverySectionTemplate">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SourceLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="1" Content="{Binding OpenSourceLabel}" NavigateUri="{Binding SourceUri}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding PeriodText}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding CacheStatus}" TextWrapping="Wrap" FontSize="12"
                           Visibility="{Binding HasCacheStatus, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" />
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="0,16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasEmptyState, Converter={StaticResource BooleanToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource DiscoveryEntryTemplate}" HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Padding="24,16,24,20" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" VerticalAlignment="Center"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            <Button Grid.Column="2" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="RefreshDiscoveryHomeButton" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" />
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SectionsGrid" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ContentControl x:Name="DailySection" Content="{Binding Daily}" ContentTemplate="{StaticResource DiscoverySectionTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalAlignment="Top" />
                <ContentControl x:Name="WeeklySection" Grid.Column="1" Content="{Binding Weekly}" ContentTemplate="{StaticResource DiscoverySectionTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalAlignment="Top" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
