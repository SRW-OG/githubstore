<ContentDialog
    x:Class="GitHubStore.App.Views.AddRepositoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Text[AddTitle]}"
    PrimaryButtonText="{Binding Text[Add]}" CloseButtonText="{Binding Text[Cancel]}"
    IsPrimaryButtonEnabled="{Binding CanAdd}" PrimaryButtonClick="OnPrimaryButtonClick" DefaultButton="None">
    <ScrollViewer MaxHeight="600"><StackPanel Spacing="16" MinWidth="440">
        <TextBlock Text="{Binding Text[RepositoryUrlHint]}" TextWrapping="Wrap" />
        <TextBox Header="{Binding Text[RepositoryUrl]}" PlaceholderText="https://github.com/microsoft/PowerToys"
                 Text="{Binding RepositoryInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsEditable}" AutomationProperties.AutomationId="RepositoryUrlInput" />
        <Button Content="{Binding Text[Preview]}" Command="{Binding PreviewCommand}" AutomationProperties.AutomationId="PreviewRepositoryButton" />
        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Text[PreviewTitle]}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PreviewTitle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PreviewDescription}" TextWrapping="Wrap" MaxLines="4" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding PreviewOwner}" /><TextBlock Text="/" /><TextBlock Text="{Binding PreviewRepo}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="★" /><TextBlock Text="{Binding PreviewStars}" />
                    <TextBlock Text="{Binding PreviewLicense}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <ComboBox Header="{Binding Text[SelectCategory]}" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding Text[PreviewFirst]}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel></ScrollViewer>
</ContentDialog>
