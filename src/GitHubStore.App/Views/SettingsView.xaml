<UserControl
    x:Class="GitHubStore.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubStore.App.Views">
    <UserControl.Resources>
        <local:SettingsMessageVisibilityConverter x:Key="MessageVisibility" />
        <local:SettingsMessageOpenConverter x:Key="MessageOpen" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Text[SettingsTitle]}" Style="{StaticResource TitleTextBlockStyle}" />
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Text[SettingsCatalogLibrary]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox Header="{Binding Text[SettingsCatalogLibraryUrl]}"
                                 Text="{Binding CatalogLibraryUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2048" IsEnabled="{Binding CanApply}"
                                 AutomationProperties.AutomationId="CatalogLibraryUrlInput" />
                        <TextBlock Text="{Binding Text[SettingsCatalogLibraryHint]}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{Binding Text[SettingsCatalogLibraryAuto]}" IsChecked="{Binding SyncCatalogLibraryOnStartup, Mode=TwoWay}"
                                  IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="CatalogLibraryStartupCheckBox" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{Binding Text[SettingsCatalogLibrarySave]}" Command="{Binding SaveCatalogLibraryCommand}"
                                    IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="SaveCatalogLibrarySettingsButton" />
                            <Button Content="{Binding Text[SettingsCatalogLibrarySync]}" Command="{Binding SynchronizeCatalogLibraryCommand}"
                                    IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="SyncCatalogLibraryButton" />
                            <Button Content="{Binding Text[Cancel]}" Command="{Binding CancelCatalogLibrarySyncCommand}"
                                    Visibility="{Binding IsSynchronizingCatalogLibrary, Converter={StaticResource BooleanToVisibility}}"
                                    AutomationProperties.AutomationId="CancelCatalogLibrarySyncButton" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsSynchronizingCatalogLibrary, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Text="{Binding CatalogLibraryStatus}" TextWrapping="Wrap" AutomationProperties.AutomationId="CatalogLibraryStatusText" />
                        <TextBlock Text="{Binding CatalogLibraryError}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   AutomationProperties.AutomationId="CatalogLibraryErrorText" />

                        <!-- 软件库维护：离线检查配置问题，并导出可再次同步的库文件。 -->
                        <TextBlock Text="{Binding Text[LibraryToolsTitle]}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Text[LibraryToolsHint]}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{Binding Text[LibraryToolsInspect]}" Command="{Binding InspectLibraryCommand}"
                                    IsEnabled="{Binding CanRunLibraryTools}" AutomationProperties.AutomationId="InspectLibraryButton" />
                            <Button Content="{Binding Text[LibraryToolsExport]}" Click="OnExportLibraryClick"
                                    IsEnabled="{Binding CanRunLibraryTools}" AutomationProperties.AutomationId="ExportLibraryButton" />
                            <Button Content="{Binding Text[Cancel]}" Command="{Binding CancelLibraryToolsCommand}"
                                    Visibility="{Binding IsLibraryToolBusy, Converter={StaticResource BooleanToVisibility}}"
                                    AutomationProperties.AutomationId="CancelLibraryToolsButton" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLibraryToolBusy, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Text="{Binding LibraryToolStatus}" TextWrapping="Wrap" FontSize="12"
                                   AutomationProperties.AutomationId="LibraryToolStatusText" />
                        <TextBlock Text="{Binding LibraryToolError}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{Binding LibraryExportPath}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <Button Content="{Binding Text[LibraryEditorLoad]}" Command="{Binding LoadLibraryEditorCommand}"
                                IsEnabled="{Binding CanRunLibraryTools}" AutomationProperties.AutomationId="LoadLibraryEditorButton" />
                        <Expander Header="{Binding Text[LibraryEditorTitle]}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="LibraryEditorExpander">
                            <StackPanel DataContext="{Binding LibraryEditor}" Spacing="8">
                                <TextBlock Text="{Binding Text[LibraryEditorHint]}" TextWrapping="Wrap" />
                                <ComboBox Header="{Binding Text[LibraryEditorRepository]}" ItemsSource="{Binding Entries}"
                                          DisplayMemberPath="Name" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="LibraryEditorRepository" />
                                <ComboBox Header="{Binding Text[WizardReleaseChannel]}" ItemsSource="{Binding Channels}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding Channel, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[WizardPinnedTag]}" Text="{Binding PinnedTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <ComboBox Header="{Binding Text[WizardInstallFormat]}" ItemsSource="{Binding Formats}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding Format, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[WizardExecutable]}" Text="{Binding ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <TextBlock Text="{Binding Text[LibraryEditorPatterns]}" TextWrapping="Wrap" />
                                <CheckBox Content="x64" IsChecked="{Binding UseX64Rule, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorX64Include]}" AcceptsReturn="True" Text="{Binding X64Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorX64Exclude]}" AcceptsReturn="True" Text="{Binding X64Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <CheckBox Content="ARM64" IsChecked="{Binding UseArm64Rule, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorArmInclude]}" AcceptsReturn="True" Text="{Binding Arm64Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorArmExclude]}" AcceptsReturn="True" Text="{Binding Arm64Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <CheckBox Content="x86" IsChecked="{Binding UseX86Rule, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorX86Include]}" AcceptsReturn="True" Text="{Binding X86Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorX86Exclude]}" AcceptsReturn="True" Text="{Binding X86Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <CheckBox Content="{Binding Text[LibraryEditorAnyRule]}" IsChecked="{Binding UseAnyRule, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorAnyInclude]}" AcceptsReturn="True" Text="{Binding AnyInclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorAnyExclude]}" AcceptsReturn="True" Text="{Binding AnyExclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <TextBox Header="{Binding Text[LibraryEditorPreserve]}" AcceptsReturn="True" Text="{Binding PreservePaths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding Text[LibraryEditorPreview]}" Command="{Binding PreviewPolicyCommand}" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="LibraryEditorPreview" />
                                    <Button Content="{Binding Text[LibraryEditorSave]}" Command="{Binding SavePolicyCommand}" IsEnabled="{Binding CanSave}" AutomationProperties.AutomationId="LibraryEditorSave" />
                                </StackPanel>
                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                        </Expander>
                        <ItemsControl ItemsSource="{Binding LibraryDiagnostics}"
                                      Visibility="{Binding HasLibraryDiagnostics, Converter={StaticResource BooleanToVisibility}}"
                                      AutomationProperties.AutomationId="LibraryDiagnosticsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2">
                                        <Run Text="{Binding RepositoryKey}" FontWeight="SemiBold" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Kind}" />
                                        <Run Text="{Binding Detail}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding Text[SettingsAppearance]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <!-- Selector items are localized in code; indices map to stable enum values. -->
                        <ComboBox x:Name="ThemeSelector" Header="{Binding Text[SettingsTheme]}" MinWidth="240"
                                  IsEnabled="{Binding CanApply}" SelectionChanged="OnThemeSelectionChanged"
                                  AutomationProperties.Name="{Binding Text[SettingsTheme]}" />
                        <ComboBox x:Name="LanguageSelector" Header="{Binding Text[SettingsLanguage]}" MinWidth="240"
                                  IsEnabled="{Binding CanApply}" SelectionChanged="OnLanguageSelectionChanged"
                                  AutomationProperties.Name="{Binding Text[SettingsLanguage]}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{Binding Text[SettingsSaveAppearance]}" IsEnabled="{Binding CanApply}"
                                    Click="OnApplyAppearanceClick" AutomationProperties.AutomationId="SaveAppearanceSettingsButton" />
                            <ProgressBar IsIndeterminate="True" Width="160" VerticalAlignment="Center"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text[SettingsInstructions]}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding Text[SettingsPaths]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <TextBox Header="{Binding Text[SettingsDownloadCache]}" Text="{Binding DownloadCacheDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="DownloadCacheDirectoryInput" />
                            <TextBlock Text="{Binding DefaultCacheHint}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox Header="{Binding Text[SettingsInstallRoot]}" Text="{Binding InstallRootDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="InstallRootDirectoryInput" />
                            <TextBlock Text="{Binding DefaultInstallHint}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{Binding Text[SettingsSavePaths]}" IsEnabled="{Binding CanApply}" Click="OnApplyPathsClick"
                                    AutomationProperties.AutomationId="SavePathSettingsButton" />
                            <Button Content="{Binding Text[SettingsUseDefault]}" IsEnabled="{Binding CanApply}" Click="OnUseDefaultPathsClick"
                                    AutomationProperties.AutomationId="UseDefaultPathsButton" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding CacheUsageText}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="DownloadCacheUsageText" />
                            <TextBlock Text="{Binding Text[SettingsCacheHint]}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="{Binding Text[SettingsCacheClear]}" IsEnabled="{Binding CanClearCache}"
                                        Click="OnClearDownloadCacheClick" AutomationProperties.AutomationId="ClearDownloadCacheButton" />
                                <Button Content="{Binding Text[SettingsCacheRefresh]}" IsEnabled="{Binding CanClearCache}"
                                        Click="OnRefreshCacheUsageClick" AutomationProperties.AutomationId="RefreshDownloadCacheUsageButton" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsCacheBusy, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock Text="{Binding CacheStatus}" TextWrapping="Wrap" AutomationProperties.AutomationId="DownloadCacheStatusText" />
                            <TextBlock Text="{Binding CacheError}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       AutomationProperties.AutomationId="DownloadCacheErrorText" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text[SettingsPathsHint]}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding Text[SettingsNetwork]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="EngineSelector" Header="{Binding Text[SettingsDownloadEngine]}" MinWidth="260"
                                      IsEnabled="{Binding CanApply}" SelectionChanged="OnEngineSelectionChanged"
                                      AutomationProperties.AutomationId="DownloadEngineSelector" />
                            <TextBlock Text="{Binding Aria2Status}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text[SettingsIntegratedToolsHint]}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{Binding Text[SettingsAccelerator]}" IsChecked="{Binding UseAccelerator, Mode=TwoWay}"
                                  IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="UseAcceleratorCheckBox" />
                        <TextBlock Text="{Binding Text[SettingsAcceleratorHint]}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="{Binding Text[SettingsP2P]}" IsChecked="False" IsEnabled="False" />
                        <TextBlock Text="{Binding Text[DownloadPeerPending]}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Text[SettingsProxy]}" FontWeight="SemiBold" />
                        <ComboBox x:Name="ProxyKindSelector" MinWidth="260" SelectionChanged="OnProxyKindSelectionChanged"
                                  IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="ProxyKindSelector" />
                        <StackPanel Spacing="8">
                            <TextBox Header="{Binding Text[ProxyHost]}" Text="{Binding ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditProxy}" AutomationProperties.AutomationId="ProxyHostInput" />
                            <TextBox Header="{Binding Text[ProxyPort]}" Text="{Binding ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditProxy}" AutomationProperties.AutomationId="ProxyPortInput" />
                            <TextBox Header="{Binding Text[ProxyUser]}" Text="{Binding ProxyUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditProxy}" AutomationProperties.AutomationId="ProxyUserInput" />
                            <TextBlock Text="{Binding Text[ProxyPassword]}" />
                            <PasswordBox x:Name="ProxyPasswordBox" IsEnabled="{Binding CanEditProxy}" PasswordChanged="OnProxyPasswordChanged" />
                            <TextBlock Text="{Binding Text[ProxyPasswordHint]}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Content="{Binding Text[SettingsSaveNetwork]}" IsEnabled="{Binding CanApply}" Click="OnApplyNetworkClick"
                                AutomationProperties.AutomationId="SaveNetworkSettingsButton" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{Binding Text[DownloadTest]}" IsEnabled="{Binding CanApply}" Click="OnProbeEngineClick"
                                    AutomationProperties.AutomationId="ProbeDownloadEngineButton" />
                            <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center"
                                         Visibility="{Binding IsProbing, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Text[SettingsAi]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding Text[SettingsAiNotice]}" TextWrapping="Wrap" />
                        <TextBox Header="{Binding Text[SettingsAiEndpoint]}" Text="{Binding AiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2048" IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="AiEndpointInput" />
                        <TextBlock Text="{Binding Text[SettingsAiEndpointHint]}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox Header="{Binding Text[SettingsAiModel]}" Text="{Binding AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200" IsEnabled="{Binding CanApply}" AutomationProperties.AutomationId="AiModelInput" />
                        <TextBlock Text="{Binding Text[SettingsAiApiKey]}" />
                        <PasswordBox x:Name="AiApiKeyBox" IsEnabled="{Binding CanApply}" PasswordChanged="OnAiApiKeyChanged"
                                     AutomationProperties.Name="{Binding Text[SettingsAiApiKey]}" AutomationProperties.AutomationId="AiApiKeyInput" />
                        <TextBlock Text="{Binding Text[SettingsAiKeyHint]}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="{Binding Text[SettingsSaveAi]}" IsEnabled="{Binding CanApply}" Click="OnApplyAiClick"
                                AutomationProperties.AutomationId="SaveAiSettingsButton" />
                    </StackPanel>
                </Border>
                <!-- 自更新：更新的是 GitHubStore 自己，不是目录里的应用。 -->
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Text[SelfUpdateTitle]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding SelfUpdateCurrentVersion}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="SelfUpdateCurrentVersionText" />
                        <TextBlock Text="{Binding Text[SelfUpdateNoAutoUpdate]}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{Binding Text[SelfUpdateCheck]}" Command="{Binding CheckForUpdateCommand}"
                                    AutomationProperties.AutomationId="CheckForUpdateButton" />
                            <Button Content="{Binding Text[Cancel]}" Command="{Binding CancelSelfUpdateCommand}"
                                    Visibility="{Binding IsSelfUpdateBusy, Converter={StaticResource BooleanToVisibility}}"
                                    AutomationProperties.AutomationId="CancelSelfUpdateButton" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{Binding IsSelfUpdateBusy, Converter={StaticResource BooleanToVisibility}}" />
                        <StackPanel Spacing="4" Visibility="{Binding HasSelfUpdateCandidate, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{Binding SelfUpdateCandidateVersion}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SelfUpdateCandidateVersionText" />
                            <HyperlinkButton Content="{Binding Text[SelfUpdateReleaseNotes]}"
                                             NavigateUri="{Binding SelfUpdateReleaseNotesUrl}"
                                             AutomationProperties.AutomationId="SelfUpdateReleaseNotesLink" />
                            <Button Content="{Binding Text[SelfUpdateDownload]}" Command="{Binding DownloadSelfUpdateCommand}"
                                    AutomationProperties.AutomationId="DownloadUpdateButton" />
                        </StackPanel>
                        <ProgressBar Value="{Binding SelfUpdateProgressPercent}" Maximum="100" Width="320"
                                     HorizontalAlignment="Left"
                                     Visibility="{Binding IsSelfUpdateBusy, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Text="{Binding SelfUpdateVerificationBasis}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="SelfUpdateVerificationBasisText" />
                        <TextBlock Text="{Binding SelfUpdateStatus}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="SelfUpdateStatusText" />
                        <TextBlock Text="{Binding SelfUpdateError}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   AutomationProperties.AutomationId="SelfUpdateErrorText" />
                        <StackPanel Spacing="4">
                            <!-- 只有已通过 SHA-256 校验的安装包才会让这个按钮可用；点击后仍需在对话框里确认。 -->
                            <Button Content="{Binding Text[SelfUpdateInstall]}" IsEnabled="{Binding CanInstallSelfUpdate}"
                                    Click="OnInstallSelfUpdateClick"
                                    AutomationProperties.AutomationId="InstallUpdateButton" />
                            <TextBlock Text="{Binding Text[SelfUpdateLaunchHint]}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Text[AboutTitle]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding Text[AppDescription]}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RuntimeDescription}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Text[CurrentBehavior]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding Text[CurrentBehaviorDescription]}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- Feedback stays visible while the settings form scrolls. -->
        <StackPanel Grid.Row="1" Margin="24,0,24,16" Spacing="8" MaxWidth="900" HorizontalAlignment="Left"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibility}}">
            <InfoBar IsOpen="{Binding ErrorMessage, Converter={StaticResource MessageOpen}}" IsClosable="False"
                     Severity="Error" Message="{Binding ErrorMessage}" AutomationProperties.Name="{Binding ErrorMessage}"
                     AutomationProperties.AutomationId="SettingsErrorFeedback" />
            <InfoBar IsOpen="{Binding StatusMessage, Converter={StaticResource MessageOpen}}" IsClosable="False"
                     Severity="Success" Message="{Binding StatusMessage}" AutomationProperties.Name="{Binding StatusMessage}"
                     AutomationProperties.AutomationId="SettingsSuccessFeedback" />
        </StackPanel>
    </Grid>
</UserControl>
