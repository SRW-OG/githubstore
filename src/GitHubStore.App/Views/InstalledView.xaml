<UserControl x:Class="GitHubStore.App.Views.InstalledView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Text[InstalledTitle]}" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" Content="{Binding Text[InstalledScan]}" Command="{Binding RescanCommand}"
                    AutomationProperties.AutomationId="RescanInstalledButton" />
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational"
                 Message="{Binding Text[InstalledExternalNote]}" />

        <AutoSuggestBox Grid.Row="2" PlaceholderText="{Binding Text[InstalledFilter]}"
                        Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QueryIcon="Find" AutomationProperties.Name="{Binding Text[InstalledFilter]}" />

        <!-- 单列列表直接展示版本与卸载、更新、回退三个操作，不再占用右侧详情栏。 -->
        <ListView x:Name="ProgramList" Grid.Row="3" ItemsSource="{Binding InstalledItems}"
                  SelectionMode="None" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="{Binding Text[InstalledTitle]}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="24" MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Text[InstalledCurrentVersion]}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding CurrentVersion}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Text[InstalledLatestVersion]}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding LatestVersion}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Content="{Binding Text[InstalledUninstall]}" Tag="{Binding}"
                                        IsEnabled="{Binding CanUninstall}" Click="OnUninstallClick"
                                        AutomationProperties.AutomationId="UninstallButton" />
                                <Button Content="{Binding Text[InstalledUpdate]}" Tag="{Binding}"
                                        IsEnabled="{Binding CanUpdate}" Click="OnUpgradeClick"
                                        AutomationProperties.AutomationId="UpgradeButton" />
                                <Button Content="{Binding Text[InstalledRollback]}" Tag="{Binding}"
                                        IsEnabled="{Binding CanRollback}" Click="OnRollbackClick"
                                        AutomationProperties.AutomationId="RollbackButton" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="4" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
