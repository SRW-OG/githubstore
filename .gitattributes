# Normalize text on commit; keep Windows-native source/scripts readable on checkout.
* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.xaml text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.zip binary
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
