    <Compile Include="..\..\src\GitHubStore.App\ViewModels\InstalledViewModel.Ai.cs" Link="ViewModels\InstalledViewModel.Ai.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\InstallationViewModel.Ai.cs" Link="ViewModels\InstallationViewModel.Ai.cs" />
