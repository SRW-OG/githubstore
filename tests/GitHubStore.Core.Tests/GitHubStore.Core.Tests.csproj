<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GitHubStore.Core\GitHubStore.Core.csproj" />
    <ProjectReference Include="..\..\src\GitHubStore.Platform.Win32\GitHubStore.Platform.Win32.csproj" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\DiscoveryHomeViewModel.cs" Link="ViewModels\DiscoveryHomeViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\ShellViewModel.cs" Link="ViewModels\ShellViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Discovery\*.cs" Link="Services\Discovery\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\LauncherViewModel.cs" Link="ViewModels\LauncherViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Launcher\ManagedAppLauncher.cs" Link="Services\Launcher\ManagedAppLauncher.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\CatalogViewModel.Cards.cs" Link="ViewModels\CatalogViewModel.Cards.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\CatalogCardViewModel.cs" Link="ViewModels\CatalogCardViewModel.cs" />
