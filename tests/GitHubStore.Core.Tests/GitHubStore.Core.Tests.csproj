    <Compile Include="..\..\src\GitHubStore.App\Services\Markdown\MarkdownDocument.cs" Link="Services\Markdown\MarkdownDocument.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Markdown\MarkdownParser.cs" Link="Services\Markdown\MarkdownParser.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\InstallationViewModel.cs" Link="ViewModels\InstallationViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Installation\*.cs" Link="Services\Installation\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\DownloadsViewModel.cs" Link="ViewModels\DownloadsViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\SourcesViewModel.cs" Link="ViewModels\SourcesViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Download\*.cs" Link="Services\Download\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Acceleration\*.cs" Link="Services\Acceleration\%(Filename)%(Extension)" />
