    <Compile Include="..\..\src\GitHubStore.App\Services\Inventory\*.cs" Link="Services\Inventory\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Tools\*.cs" Exclude="..\..\src\GitHubStore.App\Services\Tools\Windows*.cs" Link="Services\Tools\%(Filename)%(Extension)" />
