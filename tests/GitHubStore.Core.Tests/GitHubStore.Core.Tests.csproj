    <Compile Include="..\..\src\GitHubStore.App\Services\Ai\*.cs" Link="Services\Ai\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\CatalogViewModel.cs" Link="ViewModels\CatalogViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\AddRepositoryViewModel.cs" Link="ViewModels\AddRepositoryViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\SettingsViewModel.cs" Link="ViewModels\SettingsViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\SettingsViewModel.CatalogLibrary.cs" Link="ViewModels\SettingsViewModel.CatalogLibrary.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Preferences\AppPreferences.cs" Link="Services\Preferences\AppPreferences.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Preferences\PreferencesService.cs" Link="Services\Preferences\PreferencesService.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Preferences\StorageLocations.cs" Link="Services\Preferences\StorageLocations.cs" />
    <Compile Include="..\..\src\GitHubStore.App\ViewModels\InstalledViewModel.cs" Link="ViewModels\InstalledViewModel.cs" />
    <Compile Include="..\..\src\GitHubStore.App\Services\Localization\LocalizationService.cs" Link="Services\Localization\LocalizationService.cs" />
